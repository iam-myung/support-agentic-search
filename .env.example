# Copy to .env and fill locally. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://support:support@127.0.0.1:5432/support
LOG_LEVEL=INFO
# Phase 1 prototype API: open (local) | disabled | local_only (pilot must not leave open bypass)
PHASE1_API_MODE=open
# Auth persistence: memory (unit/default) | postgres (pilot / S9 SMOKE)
AUTH_BACKEND=memory
# DashScope OpenAI-compatible (https://dashscope.aliyuncs.com/compatible-mode/v1)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
CORPUS_ROOT=fixtures/corpus
EVAL_OUTPUT_ROOT=eval_output
# OP-13: only directory allowed for Prompt template file reads (no secrets here)
CONFIG_ROOT=config_templates
# Local compose Redis (required for GET /health/ready)
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_SIGNING_KEY=
PUBLIC_BASE_URL=
WORKER_LEASE_SECONDS=60
CHECKPOINT_RETENTION_DAYS=30
# Worker: real (production default) | deterministic_final (tests only)
WORKER_MODE=real
